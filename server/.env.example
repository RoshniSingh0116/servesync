# ServeSync — Server Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit the actual .env file to version control.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name
MONGODB_DB_NAME=ServeSync

# Express server port
PORT=5001

# ── Admin seed credentials ────────────────────────────────────────────────
# Used by any future seed script to create the initial admin account.
# Change these before running in any shared / production environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Future: JWT (not yet installed) ──────────────────────────────────────
# Once bcryptjs and jsonwebtoken are added (npm install bcryptjs jsonwebtoken),
# uncomment and set a strong random secret (e.g. openssl rand -hex 64).
# JWT_SECRET=replace_with_a_long_random_secret
# JWT_EXPIRES_IN=8h
